source "https://rubygems.org"

# همون نسخه‌ای از جکیل و پلاگین‌ها که خود گیت‌هاب پیجز موقع build استفاده می‌کنه —
# یعنی هرچی محلی درست دیدی، رو گیت‌هاب هم همون‌جوری در میاد.
gem "github-pages", group: :jekyll_plugins

# اگه Ruby >= 3.4 داری این دوتا رو هم لازم داری (دیگه تو استاندارد لایبرری نیستن):
gem "logger"
gem "csv"
gem "base64"

# ویندوز دیتابیس IANA timezone رو خودش نداره، جکیل بدون این fail می‌کنه:
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
